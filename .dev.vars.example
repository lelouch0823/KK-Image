# =============================================================================
# 本地开发环境敏感变量
# SOTA: 根据 Cloudflare 官方文档，敏感凭据应放在此文件而非 wrangler.toml
# ⚠️ 此文件不应提交到 Git！请确保 .gitignore 包含 .dev.vars*
# =============================================================================

# 管理员认证
BASIC_USER="admin"
BASIC_PASS="your-local-password"
JWT_SECRET="your-local-jwt-secret-change-me"

# Telegram 存储配置 (如使用)
TG_Bot_Token=""
TG_Chat_ID=""

# S3 兼容存储配置 (如使用)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI 助手 API Key
AI_API_KEY=""

# 内容审查 API Key
ModerateContentApiKey=""

# Sentry 错误监控 DSN
SENTRY_DSN=""

# Turnstile 防滥用验证
TURNSTILE_SECRET_KEY=""

# 微信小程序配置
WECHAT_APPID=""
WECHAT_SECRET=""
