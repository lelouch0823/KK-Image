{
  "name": "kk-life",
  "version": "2.0.0",
  "description": "Free image hosting solution using Cloudflare Pages and Telegram Bot API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src functions",
    "lint:fix": "eslint src functions --fix",
    "format": "prettier --write \"src/**/*.{js,vue}\" \"functions/**/*.js\"",
    "ci-test": "concurrently --kill-others --success first \"pnpm start\" \"wait-on http://localhost:8080 && mocha --exit\"",
    "test": "mocha",
    "test:webhook": "node test/webhook-test.js",
    "start": "wrangler pages dev dist --binding BASIC_USER=admin --binding BASIC_PASS=123 --binding JWT_SECRET=dev-secret-key-123 --port 8080",
    "dev:full": "pnpm build && pnpm start",
    "deploy": "pnpm build && wrangler pages deploy dist",
    "deploy:check": "node scripts/deploy-check.js",
    "deploy:verify": "pnpm build && pnpm start & sleep 5 && pnpm deploy:check && pkill -f wrangler"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@hono/zod-validator": "^0.4.1",
    "@sentry/tracing": "^7.114.0",
    "@vueuse/core": "^14.1.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "hono": "^4.11.3",
    "html2pdf.js": "^0.12.1",
    "jszip": "^3.10.1",
    "marked": "^17.0.1",
    "nprogress": "^0.2.0",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^4.5.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^3.8.0",
    "eslint-plugin-vue": "^10.6.2",
    "form-data": "^4.0.3",
    "jsdom": "^27.4.0",
    "mocha": "^10.6.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "sass-embedded": "^1.97.1",
    "tailwindcss": "^4.1.18",
    "terser": "^5.43.1",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^7.2.0",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.54.0"
  }
}