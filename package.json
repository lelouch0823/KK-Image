{
  "name": "kk-life",
  "version": "2.0.0",
  "description": "Full-stack Cloudflare-native management system for products, sales, and reservations, powered by Pages, D1, R2, and KV.",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"vite,cf\" -c \"cyan,blue\" \"node node_modules/vite/bin/vite.js\" \"pnpm db:migrate:local && wrangler pages dev http://localhost:3000 --binding BASIC_USER=admin --binding BASIC_PASS=123 --binding JWT_SECRET=dev-secret-key-123 --binding CRON_SECRET=dev-secret --port 8080\"",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "eslint src functions scripts test",
    "lint:fix": "eslint src functions scripts test --fix",
    "format": "prettier --write \"src/**/*.{js,vue}\" \"functions/**/*.js\" \"scripts/**/*.{js,mjs,cjs}\" \"test/**/*.js\" \"docs/**/*.md\" \"minisales/**/*.{ts,json,md}\"",
    "ci-test": "concurrently --kill-others --success first \"pnpm start\" \"wait-on http://localhost:8080 && pnpm test\"",
    "test": "pnpm test:unit:run && node scripts/run-mocha-tests.mjs",
    "test:unit": "node node_modules/vitest/vitest.mjs",
    "test:unit:run": "node node_modules/vitest/vitest.mjs run",
    "test:ui": "node node_modules/vitest/vitest.mjs --ui",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "node node_modules/playwright/cli.js test",
    "test:e2e:ui": "node node_modules/playwright/cli.js test --ui",
    "test:minisales": "pnpm --dir minisales test:unit",
    "check:minisales": "pnpm test:minisales && pnpm typecheck:minisales",
    "test:audit": "node node_modules/vitest/vitest.mjs functions/lib/hono/_shared/__tests__/audit-route-contract-metadata.test.js functions/lib/hono/_shared/__tests__/audit-runtime-alignment.test.js functions/lib/hono/routes/manage/__tests__/audit-logs-routes.test.js functions/lib/hono/routes/manage/__tests__/albums-routes.test.js functions/lib/hono/routes/manage/__tests__/upload-route.test.js functions/lib/hono/routes/manage/__tests__/ops-support-routes.test.js functions/lib/hono/routes/manage/__tests__/folders-routes.test.js functions/lib/hono/routes/sales/__tests__/audit-routes.test.js functions/lib/hono/routes/manage/orders/__tests__/create-routes.test.js functions/lib/hono/routes/manage/products/__tests__/batch-routes.test.js functions/lib/hono/routes/manage/spaces/__tests__/subspaces-routes.test.js functions/lib/hono/routes/v1/__tests__/webhooks-routes.test.js functions/lib/hono/routes/v1/__tests__/file-folder-audit-routes.test.js scripts/qa/__tests__/audit-coverage-consistency.test.js functions/lib/hono/middleware/__tests__/auth-opa.test.js functions/lib/hono/middleware/__tests__/auth-public-routes.test.js",
    "test:real-api": "REAL_API_PROFILE=fast node scripts/run-real-api-tests.mjs",
    "test:real-api:fast": "REAL_API_PROFILE=fast node scripts/run-real-api-tests.mjs",
    "test:real-api:blackbox": "REAL_API_PROFILE=blackbox node scripts/run-real-api-tests.mjs",
    "test:real-api:coverage": "REAL_API_PROFILE=coverage node scripts/run-real-api-tests.mjs",
    "test:real-api:coverage:blackbox": "REAL_API_PROFILE=coverage:blackbox node scripts/run-real-api-tests.mjs",
    "test:real-api:full-chain": "REAL_API_PROFILE=full-chain node scripts/run-real-api-tests.mjs",
    "test:real-api:full-chain:blackbox": "REAL_API_PROFILE=full-chain:blackbox node scripts/run-real-api-tests.mjs",
    "test:real-api:webhook": "node test/webhook-test.js",
    "authz:policy:test": "node scripts/policy/run-opa.mjs test policy/authz.rego policy/tests -v",
    "authz:policy:build": "node scripts/policy/compile-opa.mjs",
    "authz:policy:watch": "node scripts/policy/watch-opa.mjs",
    "test:webhook": "node test/webhook-test.js",
    "start": "pnpm db:migrate:local && wrangler pages dev dist --binding BASIC_USER=admin --binding BASIC_PASS=123 --binding JWT_SECRET=dev-secret-key-123 --binding CRON_SECRET=dev-secret --port 8080",
    "dev:full": "pnpm build && pnpm start",
    "dev:dist": "pnpm build && pnpm start",
    "deploy": "pnpm build && wrangler pages deploy dist",
    "deploy:check": "node scripts/deploy-check.js",
    "deploy:verify": "node scripts/deploy-verify.mjs",
    "deploy:preview": "pnpm build && wrangler pages deploy dist --branch preview",
    "deploy:prod": "pnpm build && wrangler pages deploy dist --branch main",
    "db:migrate:preview": "node scripts/d1-safe-migrate.mjs preview",
    "db:migrate:prod": "node scripts/d1-safe-migrate.mjs production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck:minisales": "pnpm --dir minisales typecheck",
    "db:migrate:preview:raw": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:prod:raw": "wrangler d1 migrations apply DB --env production --remote",
    "db:migrations:check-prefix": "node scripts/check-migration-prefixes.mjs",
    "qa:check-direct-protected-fetch": "node scripts/qa/check-direct-protected-fetch.mjs",
    "qa:check-audit-route-coverage": "node scripts/qa/check-audit-route-coverage.mjs",
    "qa:check-audit-route-coverage:json": "node scripts/qa/check-audit-route-coverage.mjs --json",
    "qa:check-ui-token-integrity": "node scripts/qa/check-ui-token-integrity.mjs",
    "qa:check-ui-foundation-usage": "node scripts/qa/check-ui-foundation-usage.mjs",
    "qa:check-minisales-ui-contract": "node scripts/qa/check-minisales-ui-contract.mjs",
    "qa:check-design-system": "pnpm qa:check-ui-token-integrity && pnpm qa:check-ui-foundation-usage",
    "qa:admin-flows": "node scripts/qa/admin-business-flow-smoke.cjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@sentry/cloudflare": "^8.52.0",
    "@tanstack/vue-virtual": "^3.13.18",
    "@vueuse/core": "^14.1.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "hono": "^4.11.7",
    "html2pdf.js": "^0.12.1",
    "jszip": "^3.10.1",
    "marked": "^17.0.1",
    "nprogress": "^0.2.0",
    "vue": "^3.5.27",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260531.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^3.8.0",
    "eslint-plugin-vue": "^10.6.2",
    "form-data": "^4.0.3",
    "jsdom": "^27.4.0",
    "mocha": "^10.6.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "sass-embedded": "^1.97.1",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.3",
    "wait-on": "^7.2.0",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.71.0"
  }
}
