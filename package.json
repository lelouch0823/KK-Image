{
  "name": "kk-life",
  "version": "2.0.0",
  "description": "Free image hosting solution using Cloudflare Pages and Telegram Bot API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ci-test": "concurrently --kill-others --success first \"npm run start\" \"wait-on http://localhost:8080 && mocha --exit\"",
    "test": "mocha",
    "test:webhook": "node test/webhook-test.js",
    "start": "npx wrangler pages dev dist --binding BASIC_USER=admin --binding BASIC_PASS=123 --port 8080 --persist-to ./data",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:check": "node scripts/deploy-check.js",
    "deploy:verify": "npm run build && npm run start & sleep 5 && npm run deploy:check && pkill -f wrangler"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@hono/zod-validator": "^0.7.6",
    "@sentry/tracing": "^7.114.0",
    "@vueuse/core": "^14.1.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "hono": "^4.11.3",
    "html2pdf.js": "^0.12.1",
    "jszip": "^3.10.1",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^4.5.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "form-data": "^4.0.3",
    "mocha": "^10.6.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "sass-embedded": "^1.97.1",
    "tailwindcss": "^4.1.18",
    "terser": "^5.43.1",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^7.2.0",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.54.0"
  }
}