<!-- pages/stats/stats.wxml -->
<t-navbar title="业绩统计" left-arrow fixed placeholder bind:go-back="handleBack" />
<view class="page" style="padding-top: 20rpx">
    <scroll-view class="content" scroll-y type="list" refresher-enabled refresher-triggered="{{loading}}" bindrefresherrefresh="onPullDownRefresh">
        <!-- 骨架屏加载 -->
        <view wx:if="{{loading && stats.totalOrders === 0}}" class="skeleton-stats" style="padding: 30rpx;">
            <t-skeleton rowCol="{{statsRowCol}}" loading></t-skeleton>
        </view>
        <!-- Web Style: Top Stats Cards (White bg, colored text/icon) -->
        <view wx:else class="stats-overview">
            <!-- Card 1: Total Orders (Blue) -->
            <view class="stat-card">
                <view class="stat-icon-bg blue">
                    <t-icon name="shop" size="40rpx" color="#3b82f6" />
                </view>
                <view class="stat-info">
                    <text class="stat-label">总订单数</text>
                    <text class="stat-num blue">{{stats.totalOrders}}</text>
                </view>
            </view>
            <!-- Card 2: Completed (Green) -->
            <view class="stat-card">
                <view class="stat-icon-bg green">
                    <t-icon name="check-circle" size="40rpx" color="#10b981" />
                </view>
                <view class="stat-info">
                    <text class="stat-label">已完成</text>
                    <text class="stat-num green">{{stats.completedOrders}}</text>
                </view>
            </view>
            <!-- Card 3: Month (Purple) -->
            <view class="stat-card full-width">
                <view class="row-between">
                    <view class="flex-row">
                        <view class="stat-icon-bg purple">
                            <t-icon name="calendar" size="40rpx" color="#8b5cf6" />
                        </view>
                        <view class="stat-info">
                            <text class="stat-label">本月订单</text>
                            <text class="stat-num purple">{{stats.monthOrders}}</text>
                        </view>
                    </view>
                    <!-- Mini Chart for Month -->
                    <view wx:if="{{!loading && stats.monthlyTrend.length > 0}}" class="mini-chart">
                        <view wx:for="{{stats.monthlyTrend}}" wx:key="date" class="mini-bar" style="height: {{item.count / maxCount * 100}}%; opacity: {{index === stats.monthlyTrend.length - 1 ? 1 : 0.4}}"></view>
                    </view>
                </view>
            </view>
        </view>
        <!-- Web Style: Layout for Charts/Lists -->
        <view class="section-card">
            <view class="card-header">
                <view class="title-with-mark">
                    <view class="mark-line"></view>
                    <text class="title">近期趋势</text>
                </view>
                <t-icon name="chart" size="32rpx" color="#9ca3af" />
            </view>
            <view wx:if="{{loading}}" class="loading-state">
                <t-loading theme="spinner" size="40rpx" text="加载数据中..." />
            </view>
            <view wx:elif="{{stats.monthlyTrend.length === 0}}" class="empty-state">
                <t-empty icon="info-circle" description="暂无近期数据" />
            </view>
            <!-- Line Chart Canvas -->
            <view wx:else class="chart-container">
                <canvas type="2d" id="trendChart" class="trend-chart-canvas" style="width: 100%; height: 400rpx;"></canvas>
                <!-- X Axis Labels -->
                <view class="chart-x-labels">
                    <text wx:for="{{chartLabels}}" wx:key="*this" class="x-label">{{item}}</text>
                </view>
            </view>
        </view>
    </scroll-view>
</view>
<wxs module="format">
var getDate = function(str) {
  if (!str) return '';
  return str.substring(5); 
}
module.exports = {
  getDate: getDate
};
</wxs>
