<view class="page">
  <t-navbar title="业绩统计" left-arrow fixed placeholder bind:go-back="handleBack" />

  <scroll-view
    class="page__scroll"
    scroll-y
    type="list"
    refresher-enabled
    refresher-triggered="{{state === 'loading'}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <view class="page__content">
      <view class="header-card">
        <view>
          <text class="header-card__title">销售概览</text>
          <text class="header-card__subtitle">从订单规模、完结数量和近 30 天趋势观察当前销售节奏。</text>
        </view>
        <t-button
          wx:if="{{viewModel && viewModel.showBindWechatAction}}"
          size="small"
          variant="outline"
          bind:tap="handleBindWechat"
          loading="{{bindingWechat}}"
        >
          绑定微信
        </t-button>
      </view>

      <sales-state-panel wx:if="{{state === 'loading'}}" loading="{{true}}" />
      <sales-state-panel wx:elif="{{state === 'error'}}" error="{{errorMessage}}" bind:retry="handleRetry" />
      <sales-state-panel wx:elif="{{state === 'empty'}}" empty="{{true}}" emptyText="暂无统计数据" />

      <block wx:else>
        <view class="metrics-grid">
          <sales-stats-metric
            wx:for="{{viewModel.metrics}}"
            wx:key="key"
            metric="{{item}}"
          />
        </view>

        <view class="chart-card">
          <view class="chart-card__header">
            <text class="chart-card__title">近 30 天订单趋势</text>
            <text class="chart-card__subtitle">{{viewModel.chartPoints.length}} 天采样</text>
          </view>

          <view wx:if="{{viewModel.chartPoints.length === 0}}" class="chart-card__empty">
            近期暂无趋势数据
          </view>

          <view wx:else class="chart-card__body">
            <view class="chart-bars">
              <view wx:for="{{viewModel.chartPoints}}" wx:key="date" class="chart-bars__item">
                <view class="chart-bars__track">
                  <view
                    class="chart-bars__bar {{item.active ? 'chart-bars__bar--active' : ''}}"
                    style="height: {{item.percent}}%;"
                  ></view>
                </view>
                <text class="chart-bars__count">{{item.count}}</text>
                <text class="chart-bars__label">{{item.xLabel}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
