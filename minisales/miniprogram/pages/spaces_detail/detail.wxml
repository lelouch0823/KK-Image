<view class="page">
  <t-navbar title="{{pageTitle}}" left-arrow bind:go-back="handleBack" fixed placeholder />

  <view wx:if="{{state === 'loading'}}" class="page__state">
    <sales-state-panel loading="{{true}}" />
  </view>

  <view wx:elif="{{state === 'error'}}" class="page__state">
    <sales-state-panel error="{{errorMessage}}" bind:retry="handleRetry" />
  </view>

  <scroll-view wx:elif="{{space && viewModel}}" class="page__scroll" scroll-y type="list">
    <view class="page__content">
      <view class="summary-card">
        <view class="summary-card__head">
          <view>
            <text class="summary-card__title">{{viewModel.title}}</text>
            <text wx:if="{{viewModel.description}}" class="summary-card__description">{{viewModel.description}}</text>
          </view>
          <text class="summary-card__tag">{{viewModel.templateLabel}}</text>
        </view>

        <view class="summary-card__meta">
          <text class="summary-card__meta-item">{{viewModel.fileCount}} 个文件</text>
          <text wx:if="{{viewModel.subspaceCount > 0}}" class="summary-card__meta-item">{{viewModel.subspaceCount}} 个子空间</text>
          <text wx:if="{{viewModel.updatedText}}" class="summary-card__meta-item">{{viewModel.updatedText}}</text>
        </view>
      </view>

      <view wx:if="{{viewModel.hasTemplateComponent}}" class="template-shell">
        <template-gallery
          wx:if="{{viewModel.template === 'gallery'}}"
          space="{{space}}"
          bind:preview="handlePreview"
        />

        <template-product
          wx:elif="{{viewModel.template === 'product'}}"
          space="{{space}}"
          bind:preview="handlePreview"
          bind:swiperchange="onSwiperChange"
        />

        <template-portfolio
          wx:elif="{{viewModel.template === 'portfolio'}}"
          space="{{space}}"
          currentIndex="{{currentIndex}}"
          bind:preview="handlePreview"
          bind:swiperchange="onSwiperChange"
        />

        <template-document
          wx:elif="{{viewModel.template === 'document'}}"
          space="{{space}}"
          bind:itemtap="handleDocumentItem"
        />

        <template-collection
          wx:elif="{{viewModel.template === 'collection'}}"
          space="{{space}}"
          bind:subspacetap="handleViewSubspace"
        />
      </view>

      <block wx:else>
        <view wx:if="{{viewModel.files.length > 0}}" class="section">
          <view class="section__title">全部文件</view>
          <view class="file-grid">
            <view
              wx:for="{{viewModel.files}}"
              wx:key="id"
              class="file-item"
              data-url="{{item.url}}"
              bind:tap="previewImage"
            >
              <t-image
                wx:if="{{item.isImage}}"
                class="file-item__image"
                src="{{item.url}}"
                mode="aspectFill"
                lazy-load
              />
              <view wx:else class="file-item__image file-item__image--placeholder">
                <text class="file-item__placeholder">{{item.isVideo ? '视频' : '文件'}}</text>
              </view>
              <text class="file-item__name">{{item.name}}</text>
            </view>
          </view>
        </view>

        <sales-state-panel
          wx:else
          empty="{{true}}"
          emptyText="当前空间暂无文件"
        />
      </block>

      <view class="page__footer-spacer"></view>
    </view>
  </scroll-view>
</view>
