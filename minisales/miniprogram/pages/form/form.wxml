<!--pages/form/form.wxml-->
<view class="page">
  <t-navbar title="新建订单" left-arrow bind:go-back="handleBack" fixed placeholder />

  <scroll-view class="form-container" scroll-y type="list">
    <view class="section">
      <view class="section-title">产品图片</view>
      <t-upload
        media-type="{{['image']}}"
        max="9"
        files="{{fileList}}"
        bind:add="handleAdd"
        bind:remove="handleRemove"
        gridConfig="{{ { column: 3, width: 218, height: 218 } }}"
      />
    </view>

    <view class="section">
      <view class="section-title">基本信息</view>
      <t-input label="商品名称" placeholder="请输入商品名称" value="{{form.name}}" data-field="name" bind:change="onInput" required />
      <t-input label="品牌" placeholder="请输入品牌" value="{{form.brand}}" data-field="brand" bind:change="onInput" />
      <t-input label="系列" placeholder="请输入系列" value="{{form.series}}" data-field="series" bind:change="onInput" />
    </view>

    <view class="section">
      <view class="section-title">规格信息</view>
      <t-input label="尺寸" placeholder="如: 120x60" value="{{form.size}}" data-field="size" bind:change="onInput" />
      <t-input label="颜色" placeholder="如: 白色" value="{{form.color}}" data-field="color" bind:change="onInput" />
      <t-input label="材质" placeholder="请输入材质" value="{{form.material}}" data-field="material" bind:change="onInput" />
    </view>

    <view class="section">
      <view class="section-title">其他信息</view>
      <t-cell title="期望到货日期" note="{{form.deadline || '选择日期'}}" arrow hover bind:click="showDatePicker" />
      <t-textarea 
        label="备注" 
        placeholder="请输入备注信息" 
        value="{{form.remark}}" 
        data-field="remark" 
        bind:change="onInput" 
        maxlength="500" 
        autosize
      />
    </view>
    
    <view style="height: 48rpx;"></view>
  </scroll-view>

  <!-- 底部按钮 -->
  <view class="bottom-bar safe-area-bottom">
    <t-button block theme="primary" size="large" bind:tap="handleSubmit" loading="{{submitting}}">提交订单</t-button>
  </view>

  <!-- 日期选择器 -->
  <t-date-time-picker
    title="选择日期"
    visible="{{dateVisible}}"
    mode="date"
    defaultValue="{{form.deadline}}"
    format="YYYY-MM-DD"
    bind:confirm="onConfirmDate"
    bind:cancel="hideDatePicker"
    start="{{minDate}}"
    end="{{maxDate}}"
  />
  <t-toast id="t-toast" />
</view>
