<!--pages/index/index.wxml-->
<!-- 引入 WXS 模块 -->
<wxs src="../../utils/format.wxs" module="format" />

<view class="page">
  <!-- 顶部导航 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px; height: {{headerHeight}}px;">
    <view class="header-content" style="height: {{navContentHeight}}px;">
      <view class="header-left">
        <view class="header-icon">
          <image src="/assets/icons/orders.png" mode="aspectFit" class="icon-image"></image>
        </view>
        <view class="header-info">
          <text class="header-title">我的订单</text>
          <text class="header-subtitle">{{user.name}}</text>
        </view>
      </view>
      <view class="header-right">
        <!-- FAB 替代顶部按钮 -->
      </view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view
    class="order-list"
    type="list"
    scroll-y
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscroll="onScroll"
  >
    <!-- 加载中 -->
    <view wx:if="{{loading && orders.length === 0}}" class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && orders.length === 0}}" class="empty-state">
      <image src="/assets/icons/empty.png" mode="aspectFit" class="empty-icon"></image>
      <text class="empty-text">暂无订单</text>
      <text class="empty-hint">点击右上角"新建"创建订单</text>
    </view>

    <!-- 订单卡片列表 -->
    <block wx:else>
      <view
        wx:for="{{orders}}"
        wx:key="id"
        class="order-card list-item" 
        data-id="{{item.id}}"
        bindtap="handleViewOrder"
      >
        <!-- 主图 -->
        <view class="card-image">
          <image
            wx:if="{{item.mainImage}}"
            src="{{item.mainImage}}"
            mode="aspectFill"
            class="main-image"
            lazy-load
          ></image>
          <view wx:else class="image-placeholder">
            <text class="placeholder-text">暂无图片</text>
          </view>
          <!-- 新反馈红点 -->
          <view wx:if="{{item.hasNewFeedback}}" class="feedback-dot"></view>
        </view>

        <!-- 卡片内容 -->
        <view class="card-content">
          <view class="card-header">
            <text class="order-no">{{item.orderNo}}</text>
            <status-badge status="{{item.status}}"></status-badge>
          </view>
          <view class="card-body">
            <text wx:if="{{item.customerName}}" class="customer-name">{{item.customerName}}</text>
          </view>
          <view class="card-footer">
            <text class="order-time">{{format.formatRelativeTime(item.createdAt)}}</text>
            <text class="view-link">查看详情 ›</text>
          </view>
        </view>
      </view>
    </block>

  </scroll-view>

  <!-- 悬浮新建按钮 -->
  <view class="fab-btn {{fabVisible ? '' : 'hidden'}}" bindtap="handleNewOrder">
    <text class="fab-icon">+</text>
  </view>
</view>
