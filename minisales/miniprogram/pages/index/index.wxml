<view class="page">
  <view class="custom-navbar {{navBarVisible ? '' : 'navbar-hidden'}}" style="height: {{headerHeight}}px;">
    <sales-app-shell
      title="{{user && user.name ? user.name + '的订单' : '我的订单'}}"
      subtitle="{{user && user.store ? user.store : '销售工作台'}}"
      activeTab="orders"
      unreadCount="{{unreadCount}}"
      safeTop="{{statusBarHeight}}"
      enableNotificationsDrawer="{{true}}"
      notifications="{{notifications}}"
      notificationsLoading="{{notificationsLoading}}"
      notificationsError="{{notificationsError}}"
      bind:layout="onShellLayout"
      bind:navigate="onShellNavigate"
      bind:notifications="onShellNotifications"
      bind:notificationretry="onShellNotificationRetry"
      bind:notificationmarkall="onShellNotificationMarkAll"
      bind:notificationselect="onShellNotificationSelect"
    />
  </view>

  <scroll-view
    class="list-scroll"
    scroll-y
    type="list"
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscroll="onScroll"
    bindscrolltolower="onLoadMore"
    lower-threshold="120"
  >
    <view class="shell-spacer" style="height: {{headerHeight}}px;"></view>

    <view class="search-anchor">
      <t-input
        value="{{searchQuery}}"
        placeholder="搜索订单号或商品标题"
        clearable
        borderless
        bind:change="onSearchChange"
      />
    </view>

    <sales-state-panel wx:if="{{state === 'loading'}}" loading="{{true}}" />
    <sales-state-panel
      wx:elif="{{state === 'error'}}"
      error="{{errorMessage || '加载失败'}}"
      bind:retry="onRetryList"
    />
    <sales-state-panel
      wx:elif="{{state === 'empty'}}"
      empty="{{true}}"
      emptyText="暂无订单，点击右下角创建"
    />
    <sales-state-panel
      wx:elif="{{visibleOrders.length === 0}}"
      empty="{{true}}"
      emptyText="未找到匹配订单"
    />

    <view wx:else class="orders-list">
      <sales-order-card
        wx:for="{{visibleOrders}}"
        wx:key="id"
        order="{{item}}"
        bind:view="handleViewOrder"
      />
    </view>

    <view wx:if="{{loadingMore}}" class="loading-more">加载更多中...</view>
    <t-divider wx:if="{{!loadingMore && !canLoadMore && orders.length > 0 && !searchQuery}}" content="没有更多了" />
    <view class="footer-spacer"></view>
  </scroll-view>

  <t-fab
    icon="add"
    aria-label="新建订单"
    class="{{fabVisible ? '' : 'fab-hidden'}}"
    style="bottom: 200rpx; right: 40rpx; z-index: 9999;"
    bind:click="handleNewOrder"
  />
</view>
