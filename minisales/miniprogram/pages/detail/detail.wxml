<view class="page">
  <t-navbar title="订单详情" left-arrow bind:go-back="handleBack" fixed placeholder>
    <view slot="right" class="page__duplicate" bind:tap="handleDuplicate">
      复制
    </view>
  </t-navbar>

  <view wx:if="{{state === 'loading' && !viewModel}}" class="page__state">
    <sales-state-panel loading="{{true}}" />
  </view>

  <view wx:elif="{{state === 'error' && !viewModel}}" class="page__state">
    <sales-state-panel error="{{errorMessage}}" bind:retry="handleRetry" />
  </view>

  <scroll-view wx:elif="{{viewModel}}" class="page__scroll" scroll-y type="list">
    <view class="page__content">
      <sales-order-summary summary="{{viewModel.summary}}" bind:preview="onSummaryPreview" />

      <sales-order-lines wx:if="{{viewModel.lines.length > 0}}" class="page__section" lines="{{viewModel.lines}}" />

      <view wx:if="{{viewModel.files.length > 0}}" class="section">
        <view class="section__header">
          <text class="section__title">素材文件</text>
          <text class="section__subtitle">{{viewModel.files.length}} 个</text>
        </view>

        <view class="file-grid">
          <view
            wx:for="{{viewModel.files}}"
            wx:key="id"
            class="file-card"
            data-url="{{item.url}}"
            data-previewable="{{item.isImage}}"
            bind:tap="onFileTap"
          >
            <t-image
              wx:if="{{item.isImage}}"
              class="file-card__image"
              src="{{item.url}}"
              mode="aspectFill"
              lazy-load
            />
            <view wx:else class="file-card__image file-card__image--placeholder">
              <t-icon name="{{item.isVideo ? 'video' : 'file-copy'}}" size="40rpx" color="#64748b" />
            </view>

            <view class="file-card__copy">
              <text class="file-card__name">{{item.name}}</text>
              <text class="file-card__meta">{{item.typeLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <sales-timeline-card class="page__section" timeline="{{viewModel.timeline}}" />
      <view class="page__footer-spacer"></view>
    </view>
  </scroll-view>

  <view wx:if="{{viewModel}}" class="comment-bar safe-area-bottom">
    <view class="comment-bar__field">
      <input
        class="comment-bar__input"
        placeholder="输入留言，支持再次提交重试"
        value="{{comment}}"
        bindinput="onCommentInput"
      />
      <text wx:if="{{commentError}}" class="comment-bar__error">{{commentError}}</text>
    </view>
    <t-button
      theme="primary"
      size="small"
      bind:tap="handleSubmitComment"
      disabled="{{!canSubmitComment}}"
      loading="{{submittingComment}}"
    >
      发送
    </t-button>
  </view>
</view>
