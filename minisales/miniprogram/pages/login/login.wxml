<!--pages/login/login.wxml-->
<view class="login-page">
  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-icon">
      <image src="/assets/icons/logo.png" mode="aspectFit" class="logo-image"></image>
    </view>
    <text class="logo-title">销售助手</text>
    <text class="logo-subtitle">订单管理 · 便捷高效</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-section">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在登录...</text>
  </view>

  <!-- 登录表单 -->
  <view wx:elif="{{showPasswordLogin}}" class="login-form">
    <!-- 错误提示 -->
    <view wx:if="{{error}}" class="error-message">
      <text>{{error}}</text>
    </view>

    <!-- 用户名输入 (手机号或姓名) -->
    <view class="form-item">
      <text class="form-label">手机号/姓名</text>
      <input
        class="form-input"
        placeholder="请输入您的手机号或姓名"
        value="{{username}}"
        bindinput="onUsernameInput"
        placeholder-class="placeholder"
      />
    </view>

    <!-- 密码输入 -->
    <view class="form-item">
      <text class="form-label">登录密码</text>
      <input
        class="form-input"
        type="password"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
        placeholder-class="placeholder"
      />
    </view>

    <!-- 登录按钮 -->
    <button
      class="login-btn"
      bindtap="handleLogin"
      disabled="{{loading}}"
    >
      {{loading ? '登录中...' : '登录'}}
    </button>
  </view>

  <!-- 首次加载提示 -->
  <view wx:else class="welcome-section">
    <text class="welcome-text">正在检测登录状态...</text>
  </view>

  <!-- 底部版权 -->
  <view class="footer">
    <text class="footer-text">© 2026 KK-Life</text>
  </view>
</view>
