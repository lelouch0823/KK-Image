<view class="login-page">
  <view class="auth-card">
    <view class="brand">
      <view class="brand__icon">S</view>
      <text class="brand__title">销售助手</text>
      <text class="brand__subtitle">统一登录后可访问订单与资源</text>
    </view>

    <view class="method-tabs">
      <view
        class="method-tab {{activeMethod === 'password' ? 'method-tab--active' : ''}}"
        data-method="password"
        bind:tap="onSelectMethod"
      >
        账号密码
      </view>
      <view
        wx:if="{{canWechatLogin}}"
        class="method-tab {{activeMethod === 'wechat' ? 'method-tab--active' : ''}}"
        data-method="wechat"
        bind:tap="onSelectMethod"
      >
        微信登录
      </view>
    </view>

    <view wx:if="{{error}}" class="error-message">
      <t-icon name="error-circle" size="32rpx" />
      <text>{{error}}</text>
    </view>

    <view wx:if="{{activeMethod === 'password'}}" class="form">
      <text wx:if="{{pendingWechatBind}}" class="wechat-panel__subhint">完成账号登录后将自动绑定当前微信</text>
      <t-input
        wx:if="{{!isScopedLogin}}"
        label="账号"
        placeholder="请输入手机号或姓名"
        value="{{username}}"
        data-field="username"
        bind:change="onInput"
        clearable
      />
      <text wx:if="{{isScopedLogin}}" class="wechat-panel__subhint">当前为链接授权登录，仅需输入密码</text>
      <t-input
        label="密码"
        type="password"
        placeholder="请输入密码"
        value="{{password}}"
        data-field="password"
        bind:change="onInput"
        clearable
      />
      <t-button theme="primary" size="large" block bind:tap="handleLogin" loading="{{loading}}">
        登录并进入
      </t-button>
    </view>

    <view wx:elif="{{canWechatLogin}}" class="wechat-panel">
      <text class="wechat-panel__hint">使用微信授权快速登录当前销售账号</text>
      <t-button
        theme="success"
        size="large"
        block
        bind:tap="handleWechatLogin"
        loading="{{wechatLoading}}"
      >
        微信一键登录
      </t-button>
      <text class="wechat-panel__subhint">若提示未绑定，请切换到账号密码登录</text>
    </view>
  </view>
</view>
