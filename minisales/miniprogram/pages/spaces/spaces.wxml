<view class="page">
  <view class="custom-navbar {{navBarVisible ? '' : 'navbar-hidden'}}" style="height: {{navBarHeight}}px;">
    <sales-app-shell
      title="共享资源"
      subtitle="销售素材、合集与陈列空间"
      activeTab="spaces"
      unreadCount="{{unreadCount}}"
      safeTop="{{statusBarHeight}}"
      bind:layout="onShellLayout"
      bind:navigate="onShellNavigate"
      bind:notifications="onShellNotifications"
    />
  </view>

  <scroll-view
    class="content"
    scroll-y
    type="list"
    bindscroll="onScroll"
    refresher-enabled
    refresher-triggered="{{state === 'loading'}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <view style="height: {{navBarHeight}}px;"></view>

    <view class="page__content">
      <view class="hero-card">
        <text class="hero-card__title">共享空间</text>
        <text class="hero-card__subtitle">按模板查看画廊、合集、产品空间和文档资料，不再使用随机瀑布流。</text>
      </view>

      <sales-state-panel wx:if="{{state === 'loading'}}" loading="{{true}}" />
      <sales-state-panel wx:elif="{{state === 'error'}}" error="{{errorMessage}}" bind:retry="handleRetry" />
      <sales-state-panel wx:elif="{{state === 'empty'}}" empty="{{true}}" emptyText="暂无共享资源" />

      <view wx:else class="space-list">
        <view
          wx:for="{{spaces}}"
          wx:key="id"
          class="space-card"
          data-id="{{item.id}}"
          bind:tap="handleViewSpace"
        >
          <view class="space-card__cover">
            <t-image
              wx:if="{{item.coverUrl}}"
              class="space-card__image"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              lazy-load
            />
            <view wx:else class="space-card__image space-card__image--placeholder">
              <text class="space-card__placeholder">{{item.templateLabel}}</text>
            </view>
          </view>

          <view class="space-card__content">
            <view class="space-card__head">
              <text class="space-card__title">{{item.title}}</text>
              <text class="space-card__tag">{{item.templateLabel}}</text>
            </view>
            <text wx:if="{{item.description}}" class="space-card__description">{{item.description}}</text>
            <view class="space-card__footer">
              <text class="space-card__meta">{{item.fileCount}} 个文件</text>
              <text wx:if="{{item.updatedText}}" class="space-card__meta">{{item.updatedText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
