<!--pages/spaces/spaces.wxml-->
<!--小红书风格瀑布流布局-->
<view class="page">
  <t-navbar title="共享资源" left-arrow="{{false}}" fixed placeholder />

  <scroll-view
    class="content"
    scroll-y
    refresher-enabled
    refresher-triggered="{{loading}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <!-- 加载中 -->
    <view wx:if="{{loading && spaces.length === 0}}" class="loading-container">
      <t-loading theme="circular" size="40rpx" text="加载中..." />
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && spaces.length === 0}}" class="empty-state">
      <t-empty icon="folder" description="暂无共享资源" />
    </view>

    <!-- 小红书风格瀑布流 -->
    <view wx:else class="waterfall">
      <!-- 左列 -->
      <view class="waterfall-column">
        <view
          wx:for="{{leftColumn}}"
          wx:key="id"
          class="card"
          data-id="{{item.id}}"
          bindtap="handleViewSpace"
        >
          <view class="card-cover" style="aspect-ratio: {{item.aspectRatio || 1}};">
            <t-image
              wx:if="{{item.coverUrl}}"
              src="{{baseUrl}}{{item.coverUrl}}"
              mode="widthFix"
              width="100%"
              lazy-load
              shape="round"
            />
            <view wx:else class="cover-placeholder">
              <t-icon name="folder" size="80rpx" color="#d1d5db" />
            </view>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.name}}</text>
            <view class="card-footer">
              <view class="author">
                <view class="avatar">
                  <t-icon name="image" size="24rpx" color="#9ca3af" />
                </view>
                <text class="count">{{item.fileCount}}个</text>
              </view>
              <view class="template-tag">{{item.templateName}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 右列 -->
      <view class="waterfall-column">
        <view
          wx:for="{{rightColumn}}"
          wx:key="id"
          class="card"
          data-id="{{item.id}}"
          bindtap="handleViewSpace"
        >
          <view class="card-cover" style="aspect-ratio: {{item.aspectRatio || 1}};">
            <t-image
              wx:if="{{item.coverUrl}}"
              src="{{baseUrl}}{{item.coverUrl}}"
              mode="widthFix"
              width="100%"
              lazy-load
              shape="round"
            />
            <view wx:else class="cover-placeholder">
              <t-icon name="folder" size="80rpx" color="#d1d5db" />
            </view>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.name}}</text>
            <view class="card-footer">
              <view class="author">
                <view class="avatar">
                  <t-icon name="image" size="24rpx" color="#9ca3af" />
                </view>
                <text class="count">{{item.fileCount}}个</text>
              </view>
              <view class="template-tag">{{item.templateName}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <t-divider content="没有更多了" wx:if="{{!loading && spaces.length > 0}}" />
    <view style="height: 120rpx;"></view>
  </scroll-view>
</view>
