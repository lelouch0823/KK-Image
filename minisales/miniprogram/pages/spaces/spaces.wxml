<!-- pages/spaces/spaces.wxml -->
<!-- 小红书风格瀑布流布局 -->
<view class="page">
  <!-- 导航栏 (Auto-hide) -->
  <view class="custom-navbar {{navBarVisible ? '' : 'navbar-hidden'}}" style="height: {{navBarHeight}}px;">
    <sales-app-shell
      title="共享资源"
      subtitle="销售素材与陈列资源"
      activeTab="spaces"
      unreadCount="{{unreadCount}}"
      safeTop="{{statusBarHeight}}"
      bind:layout="onShellLayout"
      bind:navigate="onShellNavigate"
      bind:notifications="onShellNotifications"
    />
  </view>
  <scroll-view class="content" scroll-y type="list" bindscroll="onScroll" scroll-with-animation="{{false}}" refresher-enabled refresher-triggered="{{loading}}" bindrefresherrefresh="onPullDownRefresh">
    <!-- Spacer for Navbar with extra buffer -->
    <view style="height: {{navBarHeight}}px; width: 100%; flex-shrink: 0;"></view>
    <!-- 骨架屏加载 -->
    <view wx:if="{{loading && spaces.length === 0}}" class="waterfall">
      <view class="waterfall-column">
        <view wx:for="{{3}}" wx:key="index" class="skeleton-card">
          <t-skeleton rowCol="{{spacesRowCol}}" loading />
        </view>
      </view>
      <view class="waterfall-column">
        <view wx:for="{{3}}" wx:key="index" class="skeleton-card">
          <t-skeleton rowCol="{{spacesRowCol}}" loading />
        </view>
      </view>
    </view>
    <!-- 空状态 -->
    <view wx:elif="{{!loading && spaces.length === 0}}" class="empty-state">
      <t-empty icon="folder" description="暂无共享资源" />
    </view>
    <!-- 小红书风格瀑布流 -->
    <view wx:else class="waterfall">
      <!-- 左列 -->
      <view class="waterfall-column">
        <view wx:for="{{leftColumn}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="handleViewSpace">
          <view class="card-cover" style="aspect-ratio: {{item.aspectRatio || 1}};">
            <t-image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="widthFix" width="100%" lazy-load shape="round" />
            <view wx:else class="cover-placeholder">
              <t-icon name="folder" size="80rpx" color="#d1d5db" />
            </view>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.name}}</text>
            <view class="card-footer">
              <view class="author">
                <view class="avatar">
                  <t-icon name="image" size="24rpx" color="#9ca3af" />
                </view>
                <text class="count">{{item.fileCount}}个</text>
              </view>
              <view class="template-tag">{{item.templateName}}</view>
            </view>
          </view>
        </view>
      </view>
      <!-- 右列 -->
      <view class="waterfall-column">
        <view wx:for="{{rightColumn}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="handleViewSpace">
          <view class="card-cover" style="aspect-ratio: {{item.aspectRatio || 1}};">
            <t-image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="widthFix" width="100%" lazy-load shape="round" />
            <view wx:else class="cover-placeholder">
              <t-icon name="folder" size="80rpx" color="#d1d5db" />
            </view>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.name}}</text>
            <view class="card-footer">
              <view class="author">
                <view class="avatar">
                  <t-icon name="image" size="24rpx" color="#9ca3af" />
                </view>
                <text class="count">{{item.fileCount}}个</text>
              </view>
              <view class="template-tag">{{item.templateName}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <t-divider content="没有更多了" wx:if="{{!loading && spaces.length > 0}}" />
    <view class="footer-spacer"></view>
  </scroll-view>
</view>
