<!--pages/spaces/detail.wxml-->
<t-navbar title="{{space.name || '资源详情'}}" left-arrow bind:go-back="handleBack" fixed placeholder />

<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <t-loading theme="circular" size="40rpx" text="加载中..." />
  </view>

  <scroll-view wx:elif="{{space}}" class="content" scroll-y>
    
    <!-- Gallery 模板 -->
    <template-gallery
      wx:if="{{space.template === 'gallery'}}"
      space="{{space}}"
      baseUrl="{{baseUrl}}"
      bind:preview="handlePreview"
    />

    <!-- Product 模板 -->
    <template-product
      wx:elif="{{space.template === 'product'}}"
      space="{{space}}"
      baseUrl="{{baseUrl}}"
      bind:preview="handlePreview"
      bind:swiperchange="onSwiperChange"
    />

    <!-- Portfolio 模板 -->
    <template-portfolio
      wx:elif="{{space.template === 'portfolio'}}"
      space="{{space}}"
      baseUrl="{{baseUrl}}"
      currentIndex="{{currentIndex}}"
      bind:preview="handlePreview"
      bind:swiperchange="onSwiperChange"
    />

    <!-- Document 模板 -->
    <template-document
      wx:elif="{{space.template === 'document'}}"
      space="{{space}}"
      baseUrl="{{baseUrl}}"
      bind:itemtap="handleDocumentItem"
    />

    <!-- Collection 模板 -->
    <template-collection
      wx:elif="{{space.template === 'collection'}}"
      space="{{space}}"
      baseUrl="{{baseUrl}}"
      bind:subspacetap="handleViewSubspace"
    />

    <!-- Default / Custom 模板 -->
    <block wx:else>
      <view class="header-card">
        <text class="space-title">{{space.name}}</text>
        <text class="space-desc" wx:if="{{space.description}}">{{space.description}}</text>
        <view class="space-stats">
          <t-icon name="image" size="28rpx" color="#6b7280" />
          <text class="stat-text">{{space.files.length}} 个文件</text>
        </view>
      </view>

      <view class="file-section" wx:if="{{space.files.length > 0}}">
        <view class="section-title">全部文件</view>
        <view class="file-grid">
          <view
            wx:for="{{space.files}}"
            wx:key="id"
            class="file-item"
            data-url="{{baseUrl}}{{item.url}}"
            data-index="{{index}}"
            bindtap="previewImage"
          >
            <t-image
              src="{{baseUrl}}{{item.url}}"
              mode="aspectFill"
              width="100%"
              height="200"
              lazy-load
              shape="round"
            />
          </view>
        </view>
      </view>

      <view wx:else class="empty-state">
        <t-empty icon="image" description="暂无文件" />
      </view>
    </block>

    <view style="height: 48rpx;"></view>
  </scroll-view>
</view>
