<!-- 画廊模板 (瀑布流) -->
<view class="gallery-container">
  <view class="gallery-header">
    <text class="gallery-title">{{space.name}}</text>
    <text class="gallery-desc" wx:if="{{space.description}}">{{space.description}}</text>
    <view class="gallery-meta">
      <t-icon name="image" size="24rpx" color="#9ca3af" />
      <text class="meta-text">{{space.files.length || 0}} 个文件</text>
      <text class="meta-divider" wx:if="{{space.viewCount}}">·</text>
      <t-icon name="browse" size="24rpx" color="#9ca3af" wx:if="{{space.viewCount}}" />
      <text class="meta-text" wx:if="{{space.viewCount}}">{{space.viewCount}} 次浏览</text>
    </view>
  </view>
  <view class="masonry-grid" wx:if="{{space.files && space.files.length > 0}}">
    <view
      wx:for="{{space.files}}"
      wx:key="id"
      class="masonry-item"
      data-url="{{item.url}}"
      data-index="{{index}}"
      bindtap="onPreview"
    >
      <t-image
        src="{{item.url}}"
        mode="aspectFit"
        width="100%"
        height="600"
        lazy-load
        shape="round"
      />
    </view>
  </view>
  <view wx:else class="empty-state">
    <t-empty icon="image" description="暂无图片" />
  </view>
</view>
