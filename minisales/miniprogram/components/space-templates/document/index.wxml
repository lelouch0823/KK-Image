<!-- 文档库模板 (文件列表) -->
<wxs src="../filters.wxs" module="filters" />

<view class="document-container">
  <view class="document-header">
    <text class="document-title">{{space.name}}</text>
    <text class="document-desc" wx:if="{{space.description}}">{{space.description}}</text>
  </view>
  <view class="document-list" wx:if="{{space.files && space.files.length > 0}}">
    <view
      wx:for="{{space.files}}"
      wx:key="id"
      class="document-item"
      data-url="{{baseUrl}}{{item.url}}"
      data-index="{{index}}"
      bindtap="onItemTap"
    >
      <view class="file-icon {{filters.getIconClass(item.mimeType)}}">
        <t-icon name="{{filters.getFileIcon(item.mimeType)}}" size="40rpx" />
      </view>
      <view class="file-info">
        <text class="file-name">{{item.name}}</text>
        <text class="file-type">{{item.mimeType}}</text>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="#9ca3af" />
    </view>
  </view>
  <view wx:else class="empty-state">
    <t-empty icon="file" description="暂无文件" />
  </view>
</view>
