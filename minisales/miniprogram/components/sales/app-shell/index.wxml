<view class="shell sales-shell-surface" style="padding-top: {{safeTop}}px;">
  <view class="shell__header">
    <view class="shell__titles">
      <text class="shell__title">{{title}}</text>
      <text wx:if="{{subtitle}}" class="shell__subtitle">{{subtitle}}</text>
    </view>
    <view class="shell__actions">
      <view class="shell__action sales-soft-action" bind:tap="onTapScan">
        <t-icon name="scan" size="36rpx" />
      </view>
      <view class="shell__action sales-soft-action" bind:tap="onTapStats">
        <t-icon name="chart" size="36rpx" />
      </view>
      <view class="shell__action shell__action--notify sales-soft-action sales-soft-action--neutral" bind:tap="onTapNotifications">
        <t-icon name="notification" size="36rpx" />
        <text wx:if="{{unreadCount > 0}}" class="shell__badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showTabs}}" class="shell__tabs">
    <view class="shell__tab sales-pill-tab {{activeTab === 'orders' ? 'sales-pill-tab--active shell__tab--active' : ''}}" bind:tap="onTapOrders">
      订单
    </view>
    <view class="shell__tab sales-pill-tab {{activeTab === 'spaces' ? 'sales-pill-tab--active shell__tab--active' : ''}}" bind:tap="onTapSpaces">
      资源
    </view>
  </view>

  <sales-notification-drawer
    visible="{{enableNotificationsDrawer && drawerVisible}}"
    notifications="{{notifications}}"
    loading="{{notificationsLoading}}"
    error="{{notificationsError}}"
    unreadCount="{{unreadCount}}"
    bind:close="onDrawerClose"
    bind:retry="onDrawerRetry"
    bind:markall="onDrawerMarkAll"
    bind:select="onDrawerSelect"
  />
</view>
