<view class="lines-card">
  <view class="lines-card__header">
    <text class="lines-card__title">行项目进度</text>
    <text class="lines-card__subtitle">{{lines.length}} 项</text>
  </view>

  <view wx:for="{{lines}}" wx:key="id" wx:for-item="line" class="line-card">
    <view class="line-card__head">
      <view class="line-card__main">
        <t-image
          wx:if="{{line.imageUrl}}"
          class="line-card__image"
          src="{{line.imageUrl}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:else class="line-card__image line-card__image--placeholder">
          <t-icon name="image" size="36rpx" class="line-card__placeholder-icon" />
        </view>
        <view class="line-card__copy">
          <text class="line-card__name">{{line.title}}</text>
          <text class="line-card__status line-card__status--{{line.statusTone}}">{{line.statusLabel}}</text>
        </view>
      </view>
    </view>

    <view class="line-card__metrics">
      <view wx:for="{{line.metrics}}" wx:key="label" wx:for-item="metric" class="line-card__metric">
        <text class="line-card__metric-label">{{metric.label}}</text>
        <text class="line-card__metric-value">{{metric.value}}</text>
      </view>
    </view>
  </view>
</view>
